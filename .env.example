# Copy thanh .env o cung thu muc nay roi dien. .env da nam trong .gitignore.
# Moi skill trong plugin deu doc file nay; khong can dien lai o tung skill.
# Thu tu uu tien: bien moi truong cua may > .env cua skill > .env goc nay.

# 9router, endpoint OpenAI-compatible.
MECSU_BASE_URL=https://9router.mspro.io.vn/v1

# Key 9router. De trong neu 9router local khong yeu cau key.
MECSU_API_KEY=

# Model dung mac dinh. Nhieu model cach nhau dau phay de so sanh (model dau la mac dinh).
# Da do bang eval_models.py: gemini-3.7-flash-medium dat 18/18, re nhat trong nhom dat 18/18.
MECSU_MODELS=ag/gemini-3.7-flash-medium

MECSU_BATCH_SIZE=25
MECSU_CONCURRENCY=4
MECSU_TEMPERATURE=0
