.env
__pycache__/
*.pyc
.pytest_cache/

# Cache cua wrangler khi deploy (chua account id + email).
.wrangler/

# ── VÙNG LÀM VIỆC: file thật của bạn, không bao giờ push ──────────────────────
# Giữ đúng README để người clone về biết bỏ file vào đâu.
jobs/*
!jobs/README.md

# ── XƯỞNG DỰNG SKILL: bản nháp, chưa phải thành phẩm ──────────────────────────
lab/*
!lab/README.md

# ── KIẾN THỨC NỘI BỘ: cách build skill + backup nhánh cũ ──────────────────────
# GitHub chỉ chứa skill cho người dùng gọi /..., không chứa tài liệu nội bộ này.
.kb/

# Artifact của từng lần chạy thử trên file mẫu.
samples/job-*/

# ── TÀI LIỆU NỘI BỘ: cách build skill, không lên GitHub ───────────────────────
# GitHub chỉ chứa skill + cách sử dụng. Bản làm việc vẫn nằm ở máy.
CLAUDE.md
docs/specs/
docs/superpowers/
skills/*/TODO.md

# Anh chup man hinh va artifact cua trinh duyet khi kiem tra giao dien.
.playwright-mcp/
/*.png

# Skill cap project: flow dung skill. La kien thuc build -> khong len GitHub.
.claude/skills/

# Thu muc tam cua pytest (pytest.ini tro vao day). Bi xoa sach moi lan chay.
.pytest_tmp/
